{
  "name": "afft-website-v1",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/alice-public-api.test.ts tests/alice-advisor-state.test.ts tests/alice-history.test.ts tests/rent-it-live-catalog.test.ts",
    "typegen": "wrangler types cloudflare-env.d.ts --include-runtime false",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "deploy:alice": "wrangler deploy",
    "deploy:pages": "next build && wrangler pages deploy out --project-name afft-website --branch main"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.20",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "wrangler": "^4.102.0"
  }
}
